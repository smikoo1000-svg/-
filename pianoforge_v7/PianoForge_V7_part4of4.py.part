#!/usr/bin/env python3
"""
PianoForge Acoustic Ballad Compact — no pretrained AI/model weights.
A deterministic signal-processing baseline: STFT, harmonic spectral templates,
non-negative matching pursuit, spectral-flux onset detection, hysteresis note
tracking, and MIDI export. The embedded analytic table is losslessly compressed. Acoustic-ballad mode changes dynamics/pedal only, not note pitches or attacks. Intended as a practical prototype, not a guarantee
of studio-grade transcription from arbitrary mixed songs.
"""
import os, tempfile, threading, time, uuid, logging
from functools import lru_cache
from pathlib import Path
import numpy as np
import soundfile as sf
import librosa
import pretty_midi
from flask import Flask, request, render_template_string, send_file, jsonify

# Kaggle / Dataset inputs are mounted read-only. Keep all generated files in a
# writable working directory, overridable for other notebook environments.
ROOT = Path(os.environ.get("PIANOFORGE_DATA_DIR", "/kaggle/working/PianoForge")).expanduser().resolve()
UPLOAD = ROOT / "uploads"
OUTPUT = ROOT / "outputs"
UPLOAD.mkdir(parents=True, exist_ok=True)
OUTPUT.mkdir(parents=True, exist_ok=True)
app = Flask(__name__)
# Bounded resource policy: large uploads and unbounded concurrent FFT jobs can
# exhaust notebook memory. Override only when the runtime has sufficient RAM.
MAX_UPLOAD_MB = int(os.environ.get("PIANOFORGE_MAX_UPLOAD_MB", "256"))
MAX_AUDIO_SECONDS = float(os.environ.get("PIANOFORGE_MAX_AUDIO_SECONDS", "600"))
MAX_CONCURRENT_JOBS = max(1, int(os.environ.get("PIANOFORGE_MAX_CONCURRENT_JOBS", "1")))
if not 1 <= MAX_UPLOAD_MB <= 2048:
    raise ValueError("PIANOFORGE_MAX_UPLOAD_MB must be between 1 and 2048")
if not 1 <= MAX_AUDIO_SECONDS <= 7200:
    raise ValueError("PIANOFORGE_MAX_AUDIO_SECONDS must be between 1 and 7200")
app.config["MAX_CONTENT_LENGTH"] = MAX_UPLOAD_MB * 1024 * 1024
app.config["JSON_SORT_KEYS"] = False
app.config["PROPAGATE_EXCEPTIONS"] = False
_JOB_GATE = threading.BoundedSemaphore(MAX_CONCURRENT_JOBS)
app.logger.setLevel(logging.INFO)

HTML = r"""<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PianoForge Acoustic Ballad Studio</title><style>
*{box-sizing:border-box}body{margin:0;background:#090d18;color:#f3f5ff;font:15px system-ui,sans-serif}
main{max-width:850px;margin:36px auto;padding:18px}.box{border:1px solid #29344d;background:#121a2b;border-radius:22px;padding:26px;box-shadow:0 20px 60px #0005}
h1{font-size:38px;margin:4px 0}.muted{color:#a7b4ce;line-height:1.6}.tag{color:#b9adff;border:1px solid #4a417e;background:#211d3b;padding:5px 10px;border-radius:20px;font-size:12px}
.drop{margin:22px 0;padding:24px;border:1px dashed #6a7397;border-radius:14px;background:#0d1323}label{display:block;margin:14px 0 6px;font-weight:700}
input,select{width:100%;padding:12px;background:#0a1020;color:#fff;border:1px solid #36415b;border-radius:10px}
button{margin-top:20px;width:100%;padding:15px;background:linear-gradient(100deg,#8b7cff,#4b9dff);border:0;border-radius:12px;color:white;font-weight:800;font-size:16px}
#status{white-space:pre-wrap;background:#090e1b;border-radius:12px;padding:14px;margin-top:16px;display:none}.warning{font-size:12px;color:#a7b4ce}
</style></head><body><main><div class="box"><span class="tag">MULTI-PROFILE DSP · ACOUSTIC BALLAD</span><h1>PianoForge</h1>
<p class="muted">외부 학습 모델 없이 직접 구현한 다중 해상도 DSP 엔진입니다. 160개 음색·튜닝 프로필을 음높이별로 적응 선택하고, 비음수 다중음 추정과 기본음/배음 교차 검증, 온셋·재타격·강약 추정을 수행합니다. 결과물은 피아노 연주 MIDI입니다. 기본 Concert-Grade 모드는 제한된 강약 곡선, 멜로디/저음 밸런스, 미세 레가토, 절제된 서스테인 페달을 적용합니다. 기존 스타일과 전사 기능도 유지됩니다.</p>
<form id="f" enctype="multipart/form-data"><div class="drop"><b>MP3 / WAV / FLAC / OGG / M4A 업로드</b><input id="audio" type="file" name="audio" accept=".mp3,.wav,.flac,.ogg,.m4a,.aiff,.aif,audio/*" required><div id="filename" class="warning" aria-live="polite">선택된 파일 없음</div></div>
<label>분석 품질</label><select name="quality"><option value="balanced">균형</option><option value="detailed">세밀 (느림)</option><option value="fast">빠름</option></select>
<label>연주 스타일</label><select name="style"><option value="concert_grade" selected>Ultra-Realistic · Expressive · Concert-Grade</option><option value="acoustic_ballad">어쿠스틱 발라드 (기존)</option><option value="faithful">원본 타이밍 중심 (페달 보정 없음)</option></select>
<label>고음 잡음 제거 강도</label><select name="denoise_level"><option value="clean" selected>잡음만 제거 (기본 · 실제 음은 모두 보존)</option><option value="max">최대 (고음 상한 컷)</option><option value="strong">강함</option><option value="standard">보통</option><option value="off">끄기</option></select>
<label>출력 형식</label><select name="render"><option value="midi" selected>MIDI</option><option value="wav">고음질 피아노 WAV (내장 합성기)</option></select>
<label>박자 정렬</label><select name="grid"><option value="4" selected>16분음표 (기본 · 엄격)</option><option value="2">8분음표</option><option value="0">끄기</option></select>
<label>음 이어붙이기 (끊기지 않게)</label><select name="legato"><option value="1" selected>켜기 (기본)</option><option value="0">끄기</option></select>
<label>감도 임계값</label><input name="threshold" type="number" value="0.20" min="0.05" max="0.8" step="0.05">
<label>최소 음 길이 (초)</label><input name="min_dur" type="number" value="0.07" min="0.02" max="0.5" step="0.01">
<label>반음 이동</label><input name="transpose" type="number" value="0" min="-24" max="24">
<p class="warning">학습 모델·외부 전사 모듈을 사용하지 않습니다. 결과는 DSP 기반 추정 MIDI이며, 복잡한 혼합 음원은 완전한 복원을 보장하지 않습니다.</p>
<button>분석하고 MIDI 만들기</button></form><div id="status"></div></div></main>
<script>
const f=document.querySelector('#f'),s=document.querySelector('#status');
const fileInput=document.querySelector('#audio'),fileLabel=document.querySelector('#filename');
fileInput.addEventListener('change',()=>{
  const file=fileInput.files && fileInput.files[0];
  fileLabel.textContent=file ? `선택됨: ${file.name} (${(file.size/1024/1024).toFixed(2)} MB)` : '선택된 파일 없음';
});
f.addEventListener('submit',async e=>{
  e.preventDefault();
  const file=fileInput.files && fileInput.files[0];
  s.style.display='block';
  if(!file || file.size===0){
    s.textContent='오류: 업로드할 오디오 파일이 없습니다. 파일 선택 버튼을 눌러 파일을 선택한 뒤 다시 실행하세요.';
    fileInput.focus();
    return;
  }
  const allowed=/\\.(mp3|wav|flac|ogg|m4a|aiff|aif)$/i;
  if(!allowed.test(file.name)){
    s.textContent='오류: 지원하지 않는 파일 형식입니다. MP3, WAV, FLAC, OGG, M4A, AIFF 파일을 선택하세요.';
    return;
  }
  s.textContent=`업로드 중: ${file.name} (${(file.size/1024/1024).toFixed(2)} MB)`;
  const d=new FormData();
  d.append('audio',file,file.name);
  for(const name of ['quality','style','denoise_level','grid','legato','render','threshold','min_dur','transpose']){
    const field=f.elements.namedItem(name);
    if(field) d.append(name,field.value);
  }
  try{
    const r=await fetch('/convert',{method:'POST',body:d});
    if(!r.ok){
      let message=`서버 오류 (${r.status})`;
      try{const j=await r.json();message=j.error||message}catch(_){}
      throw Error(message);
    }
    const b=await r.blob();
    if(!b.size) throw Error('서버가 빈 파일을 반환했습니다.');
    const u=URL.createObjectURL(b),a=document.createElement('a');
    a.href=u;a.download=(f.elements.namedItem('render').value==='wav'?'pianoforge.wav':'pianoforge.mid');document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(u),30000);
    s.textContent='완료! 파일 다운로드가 시작됐습니다.';
  }catch(x){
    s.textContent='오류: '+(x && x.message ? x.message : String(x));
  }
});
</script></body></html>"""

def _load_embedded_bank():
    """Decode the original 88 x 160 x 2049 profile table without a 400 MB text copy."""
    expected_rows = 88 * 160
    table = np.empty((expected_rows, 2049), dtype=np.float32)
    inflater = zlib.decompressobj()
    pending = b""
    row_index = 0

    def consume(data):
        nonlocal pending, row_index
        data = pending + data
        rows = data.split(b"\n")
        pending = rows.pop()
        for row in rows:
            if not row:
                continue
            values = np.fromstring(row.decode("ascii"), sep=",", dtype=np.float32)
            if values.size != 2049 or row_index >= expected_rows:
                raise ValueError("내장 DSP 프로필 데이터가 손상되었습니다.")
            table[row_index] = values
            row_index += 1

    # Chunk length is divisible by five for base85 decoding; the last chunk may be shorter.
    for start in range(0, len(_DSP_BANK_B85), 5000):
        encoded_chunk = _DSP_BANK_B85[start:start + 5000].encode("ascii")
        compressed_chunk = base64.b85decode(encoded_chunk)
        consume(inflater.decompress(compressed_chunk))
    consume(inflater.flush())
    if pending.strip():
        values = np.fromstring(pending.decode("ascii"), sep=",", dtype=np.float32)
        if values.size != 2049 or row_index >= expected_rows:
            raise ValueError("내장 DSP 프로필 데이터가 손상되었습니다.")
        table[row_index] = values
        row_index += 1
    if row_index != expected_rows:
        raise ValueError(f"DSP 프로필 행 수가 올바르지 않습니다: {row_index}/{expected_rows}")
    table = table.reshape(88, 160, 2049)
    table /= np.maximum(np.linalg.norm(table, axis=2, keepdims=True), 1e-8)
    return table.transpose(2, 0, 1).reshape(2049, 88 * 160)


@lru_cache(maxsize=8)
def make_harmonic_templates(sr: int, n_fft: int, low=21, high=108):
    """Analytic harmonic templates; no trained model or external weights."""
    # Keep the original multi-profile matching engine and its profile-selection logic.
    # The original decimal text table is losslessly compressed and decoded row by row.
    if n_fft == 4096 and sr == 22050 and low == 21 and high == 108:
        try:
            return _load_embedded_bank()
        except Exception as exc:
            logging.getLogger(__name__).warning("Embedded profile bank unavailable; using analytic fallback: %s", exc)
    # Smaller FFT passes and a corrupted/missing profile bank use deterministic templates.
    freqs = np.fft.rfftfreq(n_fft, 1/sr)
    bank = []
    for midi in range(low, high + 1):
        f0 = 440.0 * 2 ** ((midi - 69) / 12)
        v = np.zeros_like(freqs, dtype=np.float32)
        for h in range(1, min(30, int((sr/2)/f0)) + 1):
            fh = f0 * h * math.sqrt(1 + 0.00012 * h*h)
            amp = (1.0 / (h ** 1.18)) * math.exp(-h / 26.0)
            width = max(1.2, fh * n_fft / sr * 0.0015)
            v += amp * np.exp(-0.5 * ((freqs - fh) / (width * sr/n_fft))**2)
        v *= np.maximum(freqs, 40) ** 0.12
        norm = np.linalg.norm(v) + 1e-10
        bank.append(v / norm)
    return np.asarray(bank, dtype=np.float32).T

def nn_matching_pursuit(spec, templates, rounds=5):
    """Select one tuned/timbre profile per pitch, then fit polyphonic activations."""
    V = np.asarray(spec, dtype=np.float32)
    T = np.asarray(templates, dtype=np.float32)
    if V.ndim != 2 or T.ndim != 2 or V.shape[0] != T.shape[0]:
        raise ValueError(f"DSP shape mismatch: spec={V.shape}, templates={T.shape}")
    if not np.isfinite(V).all() or not np.isfinite(T).all():
        raise ValueError("DSP 입력에 NaN/Inf가 포함되어 있습니다.")
    V = np.maximum(V, 0.0); T = np.maximum(T, 0.0)
    mean_spec = np.mean(V, axis=1)
    floor = max(float(np.max(mean_spec)) * 2e-4, 1e-8)
    weight = np.clip(1.0 / np.maximum(mean_spec, floor) ** 0.28, 0.15, 8.0).astype(np.float32)
    X = V * weight[:, None]
    if T.shape[1] == 88 * 160:
        # Low-cost candidate selection: downsample bins and inspect up to 32 energetic frames.
        freq_idx = np.arange(0, T.shape[0], 4)
        energy = np.mean(X, axis=0)
        count = min(32, X.shape[1])
        frame_idx = np.argpartition(energy, -count)[-count:]
        frame_idx.sort()
        Ts = T[freq_idx, :].reshape(len(freq_idx), 88, 160).transpose(1, 2, 0).reshape(88 * 160, len(freq_idx))
        Ts *= weight[freq_idx][None, :]
        Ts /= np.maximum(np.linalg.norm(Ts, axis=1, keepdims=True), 1e-8)
        Xs = X[freq_idx][:, frame_idx]
        score = (Ts @ Xs).reshape(88, 160, -1)
        frame_weight = np.maximum(np.mean(Xs, axis=0), 1e-8)
        profile_score = np.sum(np.maximum(score, 0.0) * frame_weight[None, None, :], axis=2)
        best = np.argmax(profile_score, axis=1)
        T = np.stack([T[:, pitch * 160 + int(best[pitch])] for pitch in range(88)], axis=1)
    elif T.shape[1] != 88:
        raise ValueError(f"Unexpected template count: {T.shape[1]}")
    A = T * weight[:, None]
    A /= np.maximum(np.linalg.norm(A, axis=0, keepdims=True), 1e-8)
    gram = A.T @ A; cross = A.T @ X; H = np.maximum(cross, 1e-8)
    iterations = int(np.clip(rounds * 8, 16, 64))
    penalty = max(float(np.mean(cross)) * 0.010, 1e-7)
    for _ in range(iterations):
        H *= np.maximum(cross - penalty, 1e-8) / np.maximum(gram @ H, 1e-8)
        np.nan_to_num(H, copy=False, nan=0.0, posinf=0.0, neginf=0.0)
        np.maximum(H, 0.0, out=H)
    return H.astype(np.float32, copy=False)

def _smooth_activations(act, width=3):
    """Small centered smoother implemented with NumPy only; preserves transients."""
    if width <= 1 or act.shape[1] < 3:
        return act
    kernel = np.asarray([0.20, 0.60, 0.20], dtype=np.float32)
    out = act.copy()
    out[:, 1:-1] = (act[:, :-2] * kernel[0] + act[:, 1:-1] * kernel[1] + act[:, 2:] * kernel[2])
    return out


def _hysteresis_mask(a, high_cut, low_ratio=0.52):
    """Start notes above a high threshold and retain them until a lower threshold."""
    active = np.zeros(len(a), dtype=bool)
    if not len(a):
        return active
    low_cut = max(high_cut * low_ratio, 1e-5)
    on = False
    for i, value in enumerate(a):
        if not on and value >= high_cut:
            on = True
        elif on and value < low_cut:
            on = False
        active[i] = on
    return active


def _adaptive_high_note_denoise(notes, enabled=True, log=print):
    """Conservative adaptive MIDI cleanup for harmonic ghosts and transient specks.

    Notes are (pitch, start, end, velocity) tuples. The filter avoids blanket
    high-note removal: it targets (1) same-pitch near-identical duplicates,
    (2) short, quiet high notes aligned to stronger lower-note harmonics, and
    (3) extremely short/quiet isolated high-frequency transients. It returns
    the original note tuple format expected by the transcription pipeline.
    """
    if not enabled or not notes:
        return notes

    # Preserve the conservative harmonic set; do not widen the pitch range
    # indiscriminately, which can erase legitimate high-register melody.
    harmonic_intervals = (12, 19, 24, 28, 31, 36)
    by_pitch = {}
    for n in notes:
        if len(n) < 4:
            # Unknown note representation: fail open rather than destroy data.
            return notes
        p, st, en, vel = n[:4]
        try:
            p, st, en, vel = int(p), float(st), float(en), int(vel)
        except (TypeError, ValueError):
            return notes
        if en <= st:
            continue
        by_pitch.setdefault(p, []).append((p, st, en, vel, n))
    for bucket in by_pitch.values():
        bucket.sort(key=lambda x: x[1])

    # Remove only near-identical same-pitch overlaps. A true repeated note
    # separated in time is retained.
    ordered = sorted(notes, key=lambda n: (int(n[0]), float(n[1]), -(float(n[2])-float(n[1])), -int(n[3])))
    deduped = []
    removed_duplicates = 0
    last_index_by_pitch = {}
    for n in ordered:
        p, st, en, vel = int(n[0]), float(n[1]), float(n[2]), int(n[3])
        idx = last_index_by_pitch.get(p)
        if idx is not None:
            prev = deduped[idx]
            pp, ps, pe, pv = int(prev[0]), float(prev[1]), float(prev[2]), int(prev[3])
            overlap = min(en, pe) - max(st, ps)
            same_attack = abs(st - ps) <= 0.025
            if overlap > 0 and same_attack:
                # Prefer longer; then louder. Replace the prior candidate only
                # if the new one is a better representation.
                if (en - st, vel) <= (pe - ps, pv):
                    removed_duplicates += 1
                    continue
                deduped[idx] = n
                removed_duplicates += 1
                last_index_by_pitch[p] = idx
                continue
        deduped.append(n)
        last_index_by_pitch[p] = len(deduped) - 1

    # Rebuild pitch index after duplicate suppression.
    by_pitch = {}
    for n in deduped:
        p, st, en, vel = int(n[0]), float(n[1]), float(n[2]), int(n[3])
        by_pitch.setdefault(p, []).append((p, st, en, vel, n))
    for bucket in by_pitch.values():
        bucket.sort(key=lambda x: x[1])

    kept = []
    removed_harmonics = 0
    removed_transients = 0

    for candidate in deduped:
        pitch, start, end, velocity = int(candidate[0]), float(candidate[1]), float(candidate[2]), int(candidate[3])
        duration = end - start
        if duration <= 0:
            continue

        # First: harmonic ghost suppression. The candidate must be high,
        # short and quiet, while a louder lower harmonic substantially overlaps
        # and shares an attack or release boundary.
        harmonic_ghost = False
        if pitch >= 78 and duration <= 0.22 and velocity <= 64:
            for interval in harmonic_intervals:
                lower_pitch = pitch - interval
                if lower_pitch < 21:
                    continue
                for op, os_, oe, ov, _ in by_pitch.get(lower_pitch, ()):
                    if os_ > end + 0.065:
                        break
                    if oe < start - 0.065:
                        continue
                    other_duration = oe - os_
                    overlap = min(end, oe) - max(start, os_)
                    if other_duration < 0.22 or ov < velocity + 16 or overlap <= 0:
                        continue
                    if overlap / max(duration, 1e-8) < 0.78:
                        continue
                    edge_match = abs(start - os_) <= 0.045 or abs(end - oe) <= 0.065
                    if edge_match:
                        harmonic_ghost = True
                        break
                if harmonic_ghost:
                    break

        if harmonic_ghost:
            removed_harmonics += 1
            continue

        # Second: remove only very short, quiet, high transient specks that
        # are not supported by a nearby musical event. This is deliberately
        # stricter than a generic high-note filter to protect real melodies.
        transient_speck = False
        if pitch >= 78 and duration <= 0.075 and velocity <= 42:
            nearby_support = False
            for other in deduped:
                if other is candidate:
                    continue
                op, os_, oe, ov = int(other[0]), float(other[1]), float(other[2]), int(other[3])
                if abs(os_ - start) <= 0.09 and abs(op - pitch) <= 7 and ov >= velocity + 8:
                    nearby_support = True
                    break
                if op == pitch and (abs(os_ - end) <= 0.06 or abs(oe - start) <= 0.06):
                    nearby_support = True
                    break
            transient_speck = not nearby_support

        if transient_speck:
            removed_transients += 1
            continue

        kept.append(candidate)

    if removed_harmonics or removed_duplicates or removed_transients:
        log(
            "적응형 MIDI 잡음 억제: "
            f"배음 의심 {removed_harmonics}개, "
            f"초단기 고음 스파이크 {removed_transients}개, "
            f"중복 {removed_duplicates}개 제거"
        )
    else:
        log("적응형 MIDI 잡음 억제: 제거 대상 없음")

    return sorted(kept, key=lambda n: (float(n[1]), int(n[0])))

# ---------------------------------------------------------------------------
# Audio-evidence high-register noise suppression
# ---------------------------------------------------------------------------
# Strength presets. "floor" = lowest pitch the filter examines, "ceil" = notes
# above it are always dropped, "stable"/"narrow" = minimum sinusoidal-peak
# stability / sharpness, "cap" = max simultaneous notes at/above `floor`,
# "harm" = lower-octave partial intervals checked, "min_dur" = shortest note.
_DENOISE_LEVELS = {
    # "clean" (default): keeps every note that has audible pitch evidence. No register ceiling;
    # only notes without a stable spectral line (noise) or crowded into a noise cluster go.
    "clean":    dict(floor=60, ceil=108, stable=0.60, narrow=2.4, cap=3, min_dur=0.07, harm=(), mid_floor=60, hi_floor=79, low_min_dur=0.06),
    "standard": dict(floor=79, ceil=100, stable=0.65, narrow=2.6, cap=3, min_dur=0.09, harm=(), mid_floor=79, hi_floor=79, low_min_dur=0.0),
    "strong":   dict(floor=79, ceil=96,  stable=0.70, narrow=3.0, cap=2, min_dur=0.10, harm=(12, 19, 24), mid_floor=79, hi_floor=79, low_min_dur=0.0),
    "max":      dict(floor=76, ceil=91,  stable=0.75, narrow=3.5, cap=1, min_dur=0.12, harm=(12, 19, 24, 28, 31, 36), mid_floor=76, hi_floor=76, low_min_dur=0.0),
}


def _magnitude_stft(y, n_fft=4096, hop=256, chunk_seconds=90, sr=22050):
    """Magnitude STFT computed in chunks so a long song never holds a complex copy in RAM."""
    n_frames = 1 + len(y) // hop
    out = np.empty((n_fft // 2 + 1, n_frames), dtype=np.float32)
    step = (int(chunk_seconds * sr) // hop) * hop
    pad = n_fft
    for a in range(0, len(y), step):
        b = min(len(y), a + step)
        seg = y[max(0, a - pad):min(len(y), b + pad)]
        D = librosa.stft(seg, n_fft=n_fft, hop_length=hop, window="hann", center=True)
        first = (a - max(0, a - pad)) // hop
        g0, g1 = a // hop, min(n_frames, -(-b // hop))
        out[:, g0:g1] = np.abs(D[:, first:first + (g1 - g0)])
        del D
    return out


def _suppress_high_register_noise(notes, y, sr, transpose, level, log=print):
    """Remove the persistent bed of high 'noise notes' using evidence from the audio itself.

    Hi-hats, breath, sibilance and vocal upper partials get fitted by the high
    templates as short pseudo-notes. A real note is a *stable, narrow spectral
    line*; noise bins jump around from frame to frame. For every note in the
    upper register we therefore measure (1) peak-bin stability, (2) peak
    sharpness against its side bins, (3) whether a louder lower note explains it
    as an overtone, and finally cap the number of simultaneous upper notes.
    Notes below the preset floor are never touched.
    """
    cfg = _DENOISE_LEVELS.get(level)
    if cfg is None or not notes:
        return notes
    n_fft, hop = 4096, 256
    fr = sr / n_fft
    S = _magnitude_stft(y, n_fft, hop, sr=sr)
    nbin, nfrm = S.shape

    def band(p0):
        c = 440.0 * 2.0 ** ((p0 - 69) / 12.0) / fr
        lo = int(np.floor(c * 2 ** (-0.5 / 12.0)))
        hi = max(int(np.ceil(c * 2 ** (0.5 / 12.0))), lo + 2)
        return max(lo, 1), min(hi, nbin - 12)

    def span(st, en):
        i0 = int(st * sr / hop)
        return i0, min(int(en * sr / hop) + 1, nfrm)

    def fundamental(p0, i0, i1):
        lo, hi = band(p0)
        if hi <= lo or i1 <= i0:
            return 0.0
        return float(np.median(S[lo:hi + 1, i0:i1].max(axis=0)))

    stats = {"ceil": 0, "short": 0, "noisy": 0, "overtone": 0, "crowd": 0}
    by_pitch = {}
    for n in notes:
        by_pitch.setdefault(int(n[0]), []).append(n)

    scored = []
    keep = []
    for note in notes:
        pitch, st, en, vel = int(note[0]), float(note[1]), float(note[2]), int(note[3])
        p0 = pitch - int(transpose)
        if p0 < cfg["floor"]:
            # Low register: pitch cannot be verified at this FFT size, so only the
            # sub-frame thumps (kick/click leakage) are removed; everything else stays.
            if en - st < cfg["low_min_dur"]:
                stats["short"] += 1
            else:
                keep.append(note)
            continue
        if p0 > cfg["ceil"]:
            stats["ceil"] += 1
            continue
        if en - st < cfg["min_dur"]:
            stats["short"] += 1
            continue
        i0, i1 = span(st, en)
        lo, hi = band(p0)
        if i1 - i0 < 3 or hi <= lo:
            stats["short"] += 1
            continue
        seg = S[lo:hi + 1, i0:i1]
        peak_idx = seg.argmax(axis=0)
        stable = float(np.mean(np.abs(peak_idx - np.median(peak_idx)) <= 1))
        cols = np.arange(i1 - i0)
        k = lo + peak_idx
        side = (S[np.maximum(k - 8, 0)[None, :] + np.arange(6)[:, None], i0 + cols[None, :]].sum(axis=0)
                + S[np.minimum(k + 3, nbin - 7)[None, :] + np.arange(6)[:, None], i0 + cols[None, :]].sum(axis=0)) / 12.0
        narrow = float(np.median(S[k, i0 + cols] / (side + 1e-9)))
        lenient = p0 < cfg["hi_floor"]   # mid register: vibrato/glides are real, test loosely
        if stable < (0.5 if lenient else cfg["stable"]) or narrow < (2.2 if lenient else cfg["narrow"]):
            stats["noisy"] += 1
            continue
        mag = float(np.median(seg.max(axis=0)))
        # Overtone test: a lower note that overlaps this one and whose own
        # fundamental is not much weaker is the more likely source of this energy.
        explained = False
        for interval in cfg["harm"]:
            q = pitch - interval
            for other in by_pitch.get(q, ()):
                ov = min(en, float(other[2])) - max(st, float(other[1]))
                if ov >= 0.6 * (en - st):
                    j0, j1 = span(max(st, float(other[1])), min(en, float(other[2])))
                    if fundamental(q - int(transpose), j0, j1) >= 0.5 * mag:
                        explained = True
                        break
            if explained:
                break
        if explained:
            stats["overtone"] += 1
            continue
        if p0 < cfg["hi_floor"]:
            keep.append(note)
            continue
        scored.append((narrow * (en - st) * np.log1p(mag), note, st, en))

    # Simultaneity cap on a 10 ms grid: strongest evidence claims time first.
    grid = 0.01
    occupancy = np.zeros(int(max(float(n[2]) for n in notes) / grid) + 3, dtype=np.int16)
    for _, note, st, en in sorted(scored, key=lambda x: -x[0]):
        a, b = int(st / grid), max(int(st / grid) + 1, int(en / grid))
        if occupancy[a:b].max() >= cfg["cap"]:
            stats["crowd"] += 1
            continue
        occupancy[a:b] += 1
        keep.append(note)

    removed = len(notes) - len(keep)
    log(f"고음 잡음 제거({level}): {removed}개 제거 "
        f"(상한 초과 {stats['ceil']}, 너무 짧음 {stats['short']}, 비음정성 잡음 {stats['noisy']}, "
        f"저음의 배음 {stats['overtone']}, 동시발음 초과 {stats['crowd']}) / 남은 음표 {len(keep)}개")
    return keep


def extract_notes(y, sr, quality, threshold, min_dur, transpose, log, high_note_denoise=True, denoise_level="clean"):
    """Deterministic multi-resolution polyphonic transcription with per-pitch onset/end refinement."""
    y = np.asarray(y, dtype=np.float32)
    if y.ndim != 1 or y.size < int(sr * 0.25) or not np.isfinite(y).all():
        raise ValueError("전사 입력 파형이 비어 있거나 잘못되었습니다.")
    if quality == "fast":
        resolutions = [(2048, 256, 3)]
    elif quality == "detailed":
        resolutions = [(4096, 160, 8), (2048, 80, 6)]
    else:
        resolutions = [(4096, 256, 6), (2048, 128, 5)]

    fused = None
    flux_fused = None
    ref_times = None
    for n_fft, hop, rounds in resolutions:
        log(f"DSP 분석: FFT={n_fft}, hop={hop}, NNLS={rounds * 6}회")
        D = librosa.stft(y, n_fft=n_fft, hop_length=hop, window="hann", center=True)
        mag = np.abs(D).astype(np.float32)
        templates = make_harmonic_templates(sr, n_fft)
        act = nn_matching_pursuit(mag, templates, rounds=rounds)
        # Preserve absolute evidence across pitches. Per-pitch normalization makes
        # noise-only bins look like genuine notes, so use one shared robust scale.
        global_scale = max(float(np.percentile(act, 99.7)), 1e-8)
        act = np.clip(act / global_scale, 0.0, 3.0)
        # Subtract a small per-pitch floor without rescaling each pitch to full range.
        baseline = np.percentile(act, 25, axis=1, keepdims=True)
        act = np.maximum(act - baseline, 0.0)
        act = _smooth_activations(act)
        # Positive spectral flux normalized robustly for attack localization.
        diff = np.maximum(0.0, np.diff(mag, axis=1, prepend=mag[:, :1]))
        flux = np.sqrt(np.mean(diff * diff, axis=0) + 1e-12)
        fscale = max(float(np.percentile(flux, 98)), 1e-8)
        flux = np.clip(flux / fscale, 0.0, 5.0)
        # Fundamental-vs-harmonic evidence helps reject subharmonic ghosts (e.g. a
        # pure A4 tone being misread as A3 because its second harmonic matches).
        fund_ratio = np.zeros((88, mag.shape[1]), dtype=np.float32)
        fundamental_energy = np.zeros((88, mag.shape[1]), dtype=np.float32)
        for pitch_idx in range(88):
            f0 = 440.0 * (2.0 ** ((pitch_idx + 21 - 69) / 12.0))
            b0 = int(round(f0 * n_fft / sr))
            rad = max(1, int(round(f0 * n_fft / sr * 0.018)))
            lo, hi = max(1, b0-rad), min(mag.shape[0], b0+rad+1)
            fundamental_amp = np.max(mag[lo:hi], axis=0) if hi > lo else np.zeros(mag.shape[1], dtype=np.float32)
            fundamental_energy[pitch_idx] = fundamental_amp
            harmonic_amps = []
            for harmonic in range(2, min(9, int((sr/2)/max(f0, 1.0))+1)):
                bh = int(round(f0 * harmonic * n_fft / sr))
                rh = max(1, int(round(bh * 0.018)))
                hlo, hhi = max(1, bh-rh), min(mag.shape[0], bh+rh+1)
                if hhi > hlo:
                    harmonic_amps.append(np.max(mag[hlo:hhi], axis=0))
            if harmonic_amps:
                harmonic_amp = np.maximum.reduce(harmonic_amps)
                fund_ratio[pitch_idx] = fundamental_amp / np.maximum(harmonic_amp, 1e-8)
            else:
                fund_ratio[pitch_idx] = 1.0
        times = librosa.frames_to_time(np.arange(act.shape[1]), sr=sr, hop_length=hop)
        if fused is None:
            fused, flux_fused, ref_times, fund_fused, fund_energy_fused = act, flux, times, fund_ratio, fundamental_energy
        else:
            aligned = np.vstack([np.interp(ref_times, times, row, left=0.0, right=0.0) for row in act]).astype(np.float32)
            aligned_flux = np.interp(ref_times, times, flux, left=0.0, right=0.0)
            aligned_fund = np.vstack([np.interp(ref_times, times, row, left=0.0, right=0.0) for row in fund_ratio]).astype(np.float32)
            aligned_fund_energy = np.vstack([np.interp(ref_times, times, row, left=0.0, right=0.0) for row in fundamental_energy]).astype(np.float32)
            fused = 0.5 * fused + 0.5 * aligned
            flux_fused = 0.5 * flux_fused + 0.5 * aligned_flux
            fund_fused = 0.5 * fund_fused + 0.5 * aligned_fund
            fund_energy_fused = 0.5 * fund_energy_fused + 0.5 * aligned_fund_energy

    act = fused
    flux = flux_fused
    # Attenuate a lower pitch only when its own fundamental is absent and a pitch
    # whose partial can explain it is simultaneously strong. This is conservative:
    # real low notes with measurable fundamentals remain intact.
    for lower in range(88):
        ratios = fund_fused[lower]
        for harmonic_semitones in (12, 19, 24, 28, 31, 36):
            upper = lower + harmonic_semitones
            if upper >= 88:
                continue
            ghost = (ratios < 0.035) & (act[upper] > 0.13) & (act[upper] > act[lower] * 0.42)
            act[lower, ghost] *= 0.22
    # Adjacent-semitone leakage guard: if a neighboring pitch owns substantially
    # more fundamental-band energy, attenuate the weaker candidate in those frames.
    # Genuine close-interval chords survive because both fundamentals have evidence.
    original_act = act.copy()
    for pitch_idx in range(88):
        for neighbor in (pitch_idx - 1, pitch_idx + 1):
            if neighbor < 0 or neighbor >= 88:
                continue
            energy_dominates = fund_energy_fused[pitch_idx] < fund_energy_fused[neighbor] * 0.32
            activation_weaker = original_act[pitch_idx] < original_act[neighbor] * 0.78
            leakage = energy_dominates & activation_weaker & (original_act[neighbor] > 0.14)
            act[pitch_idx, leakage] *= 0.28
    hop_seconds = float(np.median(np.diff(ref_times))) if len(ref_times) > 1 else 256.0 / sr
    min_frames = max(2, int(round(float(min_dur) / max(hop_seconds, 1e-6))))
    gap_frames = max(1, int(round(0.018 / max(hop_seconds, 1e-6))))
    # Per-pitch attack curve: global flux alone otherwise splits unrelated notes.
    notes = []
    for k in range(act.shape[0]):
        a = act[k]
        if not np.isfinite(a).all():
            continue
        peak = float(np.percentile(a, 99.5))
        if peak < 0.11:
            continue
        noise = float(np.percentile(a, 15))
        high_cut = max(float(threshold) * max(peak, 0.16), noise * 1.6, 0.11)
        low_cut = max(high_cut * 0.48, 0.035)
        active = _hysteresis_mask(a, high_cut, low_cut / max(high_cut, 1e-8))
        # Fill tiny gaps only when activation resumes without a strong spectral attack.
        i = 1
        while i < len(active) - 1:
            if not active[i] and active[i-1]:
                j = i
                while j < len(active) and not active[j] and j-i <= gap_frames:
                    j += 1
                if j < len(active) and active[j] and j-i <= gap_frames and float(np.max(flux[i:j+1])) < 0.75:
                    active[i:j] = True
                i = max(j, i + 1)
            else:
                i += 1
        edges = np.diff(np.r_[False, active, False].astype(np.int8))
        starts = list(np.where(edges == 1)[0])
        ends = list(np.where(edges == -1)[0])
        segments = []
        for st, en in zip(starts, ends):
            if en - st < min_frames:
                continue
            local_max = float(np.max(a[st:en]))
            # Reattack requires both a local activation rise and a broadband transient.
            cuts = []
            for q in range(max(st + 2, 1), min(en - 2, len(a) - 1)):
                if (a[q] >= a[q-1] and a[q] > a[q+1] and
                    a[q] >= max(high_cut * 0.8, local_max * 0.38) and
                    a[q] - min(a[q-1], a[q-2]) >= max(0.055, local_max * 0.12) and
                    flux[q] >= 0.38):
                    if not cuts or q - cuts[-1] >= min_frames:
                        cuts.append(q)
            bounds = [st] + cuts + [en]
            for left, right in zip(bounds, bounds[1:]):
                if right - left >= min_frames:
                    segments.append((left, right))

        for st, en in segments:
            local = a[st:en]
            local_peak = float(np.max(local))
            if local_peak < high_cut * 0.9:
                continue
            # Move onset to a nearby attack peak only when this pitch also rises there.
            search_l = max(1, st - 3)
            search_r = min(len(a) - 1, st + 3)
            candidates = [q for q in range(search_l, search_r + 1)
                          if flux[q] >= 0.32 and a[q] >= max(high_cut * 0.65, local_peak * 0.22)
                          and a[q] >= a[q-1]]
            st_ref = min(candidates, key=lambda q: abs(q-st)) if candidates else st
            onset = max(0.0, float(ref_times[st_ref]) - 0.008)
            # Use activation decay and waveform envelope to avoid extending notes to arbitrary frame boundaries.
            end_idx = min(en, len(ref_times)-1)
            end = float(ref_times[end_idx]) if end_idx > 0 else 0.0
            if end <= onset:
                continue
            # Correct frame-to-sample mapping using the actual fused hop, not a hard-coded hop.
            frame0 = max(0, min(len(y)-1, int(round(onset * sr))))
            frame1 = max(frame0+1, min(len(y), int(round(end * sr))))
            seg_y = y[frame0:frame1]
            rms = float(np.sqrt(np.mean(np.square(seg_y, dtype=np.float64)))) if seg_y.size else 0.0
            act_strength = float(np.percentile(local, 75))
            relative = float(np.clip(act_strength / max(float(np.percentile(a, 99.5)), 1e-7), 0.0, 1.0))
            # Compress dynamic range; do not independently normalize each pitch to loudness.
            loudness = float(np.clip(np.log1p(rms * 35.0) / np.log1p(35.0), 0.0, 1.0))
            vel = int(np.clip(24 + 96 * (0.58 * relative + 0.42 * loudness), 24, 120))
            pitch = int(np.clip(21 + k + int(transpose), 0, 127))
            notes.append((pitch, onset, end, vel))

    # Merge duplicate same-pitch fragments when they overlap and no genuine gap
    # separates them. This prevents STFT boundary ripples from becoming extra notes.
    notes.sort(key=lambda n: (n[0], n[1], n[2]))
    merged = []
    for note in notes:
        pitch, onset, end, velocity = note
        if merged and merged[-1][0] == pitch and onset <= merged[-1][2] + 0.012:
            prev = merged[-1]
            # A genuine retrigger separated by a gap remains a separate MIDI note.
            merged[-1] = (pitch, min(prev[1], onset), max(prev[2], end), max(prev[3], velocity))
        else:
            merged.append(note)
    # Remove high-register transient specks conservatively. The previous version
    # only targeted MIDI pitches >=88 (outside the 88-key piano range) and very
    # quiet velocities, so a large cloud of short notes on real piano keys survived.
    # A short high note is retained when it coincides with a convincing attack or
    # is supported by nearby musical activity; unsupported isolated specks are dropped.
    if high_note_denoise and merged:
        supported = []
        for note in merged:
            pitch, onset, end, velocity = note
            dur = end - onset
            if pitch >= 76 and dur <= 0.060:
                neighbors = [o for o in merged if o is not note and abs(o[1]-onset) <= 0.085
                             and abs(o[0]-pitch) <= 12 and o[3] >= max(velocity + 8, 48)
                             and (o[2]-o[1]) >= 0.075]
                same_pitch_retrigger = any(o[0] == pitch and abs(o[1]-end) <= 0.055 for o in merged if o is not note)
                if not neighbors and not same_pitch_retrigger and velocity < 58:
                    continue
            if pitch >= 84 and dur <= 0.085 and velocity < 38:
                # Require either a nearby note in the phrase or a longer same-pitch event.
                nearby = any(o is not note and abs(o[1]-onset) <= 0.10 and abs(o[0]-pitch) <= 7
                             and (o[2]-o[1]) >= 0.09 for o in merged)
                if not nearby:
                    continue
            supported.append(note)
        merged = supported

    # Remove likely semitone leakage: a very short neighboring pitch embedded in
    # a much stronger sustained note is usually spectral smearing, not a real key.
    cleaned = []
    for note in merged:
        pitch, onset, end, velocity = note
        duration = end - onset
        # Measure the candidate's actual fundamental-band support over its own span.
        # The activation dictionary alone can confuse spectral sidelobes with semitones.
        i0 = max(0, int(np.searchsorted(ref_times, onset, side="left")))
        i1 = min(len(ref_times), max(i0 + 1, int(np.searchsorted(ref_times, end, side="right"))))
        original_pitch = int(pitch) - int(transpose)
        row = original_pitch - 21
        own_fund = float(np.mean(fund_energy_fused[row, i0:i1])) if 0 <= row < 88 and i1 > i0 else 0.0
        leakage = False
        for other in merged:
            if other is note or other[0] == pitch or abs(other[0] - pitch) != 1:
                continue
            overlap = min(end, other[2]) - max(onset, other[1])
            if overlap <= min(0.025, duration * 0.15):
                continue
            old_style_ghost = (other[1] <= onset + 0.025 and other[2] >= end - 0.025
                               and (other[2] - other[1]) >= max(0.28, duration * 2.8)
                               and duration <= 0.18)
            other_original_pitch = int(other[0]) - int(transpose)
            other_row = other_original_pitch - 21
            other_fund = float(np.mean(fund_energy_fused[other_row, i0:i1])) if 0 <= other_row < 88 else 0.0
            weak_fund_ghost = (other_fund > max(own_fund * 5.0, 1e-6)
                               and other[3] >= velocity - 8
                               and overlap >= min(duration, other[2] - other[1]) * 0.65)
            if old_style_ghost or weak_fund_ghost:
                leakage = True
                break
        if not leakage:
            cleaned.append(note)
    cleaned = _adaptive_high_note_denoise(cleaned, enabled=high_note_denoise, log=log)
    if high_note_denoise:
        cleaned = _suppress_high_register_noise(cleaned, y, sr, transpose, denoise_level, log=log)
    cleaned.sort(key=lambda n: (n[1], n[0]))
    log(f"다중 해상도 분석 완료: {len(resolutions)}개 FFT 패스")
    log(f"추정 음표 수: {len(cleaned)}")
    return cleaned

def _apply_concert_grade_performance(instrument):
    """Musical MIDI shaping: controlled dynamics, phrase contour, legato and restrained pedal.

    Does not invent notes or move note onsets. It only refines velocities, tiny same-key
    gaps and sustain-pedal events; all changes are bounded to avoid turning artifacts into music.
    """
    notes = sorted(instrument.notes, key=lambda n: (n.start, n.pitch, n.end))
    if not notes:
        return

    # Estimate local pulse from note onsets; use it only to shape dynamics, never to quantize.
    starts = np.asarray([float(n.start) for n in notes], dtype=np.float64)
    gaps = np.diff(starts)
    positive_gaps = gaps[(gaps >= 0.075) & (gaps <= 1.2)]
    pulse = float(np.median(positive_gaps)) if positive_gaps.size else 0.45
    pulse = float(np.clip(pulse, 0.12, 0.9))

    # Robust phrase-level intensity envelope, plus melodic/accompaniment balance.
    # All dynamics are bounded; source velocity differences remain audible.
    window = max(0.8, min(3.2, pulse * 4.0))
    for i, note in enumerate(notes):
        t = float(note.start)
        left = int(np.searchsorted(starts, t - window, side="left"))
        right = int(np.searchsorted(starts, t + window, side="right"))
        local = notes[left:right]
        local_vel = np.asarray([n.velocity for n in local], dtype=np.float64)
        local_med = float(np.median(local_vel)) if local_vel.size else float(note.velocity)
        # Normalize against nearby dynamics to preserve broad crescendos while taming spikes.
        source = float(note.velocity)
        normalized = 0.72 * source + 0.28 * local_med

        # Upper melody gently projects; low-register accompaniment is slightly restrained.
        if note.pitch >= 76:
            register_gain = 1.045 if note.pitch < 84 else 0.94
        elif note.pitch <= 47:
            register_gain = 0.91
        else:
            register_gain = 1.0

        # Give isolated phrase starts a modest articulation lift; avoid accenting dense noise.
        prev_gap = t - float(notes[i - 1].start) if i else window
        phrase_lift = 3.0 if (i == 0 or prev_gap >= max(0.55, pulse * 2.2)) else 0.0
        # Reduce harsh isolated velocity outliers without flattening expressive dynamics.
        target = (normalized * register_gain) + phrase_lift
        note.velocity = int(np.clip(round(0.78 * target + 0.22 * source), 28, 118))

    # Light legato only for adjacent same-key notes; preserve intentional re-articulations.
    by_pitch = {}
    for note in notes:
        by_pitch.setdefault(note.pitch, []).append(note)
    for pitch_notes in by_pitch.values():
        for current, nxt in zip(pitch_notes, pitch_notes[1:]):
            gap = float(nxt.start - current.end)
            if 0.008 < gap <= min(0.035, pulse * 0.08):
                current.end = max(current.end, nxt.start - 0.006)

    # Conservative pedal from harmonic/rhythmic changes, capped to prevent muddy wash.
    bass = sorted((n for n in notes if n.pitch <= 59), key=lambda n: n.start)
    if len(bass) >= 2:
        attacks = []
        for n in bass:
            if not attacks or n.start - attacks[-1] > max(0.045, pulse * 0.18):
                attacks.append(float(n.start))
        pedal_events = []
        for i, t in enumerate(attacks):
            next_t = attacks[i + 1] if i + 1 < len(attacks) else t + min(0.8, pulse * 2.0)
            on = t + min(0.018, pulse * 0.035)
            # Release before the next bass/harmony change, with a strict duration cap.
            off = min(next_t - 0.025, t + min(0.72, pulse * 1.7))
            if off - on >= 0.12:
                pedal_events.extend((
                    pretty_midi.ControlChange(number=64, value=78, time=max(0.0, on)),
                    pretty_midi.ControlChange(number=64, value=0, time=max(on + 0.01, off)),
                ))
        instrument.control_changes = [cc for cc in instrument.control_changes if cc.number != 64]
        instrument.control_changes.extend(pedal_events)
        instrument.control_changes.sort(key=lambda cc: (cc.time, cc.value))


def apply_acoustic_ballad_performance(instrument):
    """Legacy acoustic-ballad voicing; retained for backward compatibility."""
    notes = sorted(instrument.notes, key=lambda n: (n.pitch, n.start, n.end))
    by_pitch = {}
    for note in notes:
        by_pitch.setdefault(note.pitch, []).append(note)
        note.velocity = int(np.clip(round(note.velocity * 0.88 + 5), 34, 112))
    for pitch_notes in by_pitch.values():
        for current, nxt in zip(pitch_notes, pitch_notes[1:]):
            gap = nxt.start - current.end
            if 0.0 < gap <= 0.055:
                current.end = max(current.end, nxt.start - 0.012)
    bass_attacks = sorted({round(n.start, 3) for n in instrument.notes if n.pitch <= 59})
    if len(bass_attacks) >= 2:
        pedal_events = []
        for i, start in enumerate(bass_attacks):
            next_start = bass_attacks[i + 1] if i + 1 < len(bass_attacks) else start + 1.0
            on = start + 0.025
            off = min(next_start - 0.045, start + 1.25)
            if off - on >= 0.16:
                pedal_events.append(pretty_midi.ControlChange(number=64, value=92, time=on))
                pedal_events.append(pretty_midi.ControlChange(number=64, value=0, time=off))
        instrument.control_changes.extend(pedal_events)
        instrument.control_changes.sort(key=lambda cc: cc.time)

# ---------------------------------------------------------------------------
# Built-in concert-piano synthesizer (no samples, no external soundfont)
# ---------------------------------------------------------------------------
# Physical-model-inspired additive synthesis: stretched (inharmonic) partials,
# 1-3 detuned strings per key, hammer-strike spectrum that brightens with velocity,
# strike-point comb, two-stage (prompt + after-sound) decay, hammer thump/noise,
# damper release, sustain-pedal ringing, stereo keyboard spread and soundboard/room reverb.
_SYNTH_SR = 44100


def _piano_partial_profile(pitch, vel, sr=_SYNTH_SR):
    f0 = 440.0 * 2.0 ** ((pitch - 69) / 12.0)
    v = float(np.clip(vel, 1, 127)) / 127.0
    inharm = float(np.clip(3.0e-4 * 2.0 ** ((pitch - 60) / 14.0), 1.0e-4, 6.0e-3))
    brightness = 2200.0 + 7500.0 * v ** 1.4
    tilt = 0.85 + 0.9 * (1.0 - v)
    n_max = int(min(64, (0.45 * sr) / f0))
    freqs, amps = [], []
    for n in range(1, n_max + 1):
        fn = f0 * n * np.sqrt(1.0 + inharm * n * n)
        if fn > 0.45 * sr:
            break
        comb = 0.35 + 0.65 * abs(np.sin(np.pi * n / 8.0))          # hammer strikes ~1/8 of the string
        a = (n ** -tilt) * comb * np.exp(-fn / brightness)
        if n == 1 and pitch < 45:
            a *= 0.55                                               # bass fundamentals radiate weakly
        if a < 2e-3 and n > 3:
            break
        freqs.append(fn)
        amps.append(a)
    return f0, np.asarray(freqs), np.asarray(amps)


def _piano_prototype(pitch, vel, sr=_SYNTH_SR, rng=None):
    """One key struck at `vel`, ringing freely. Returns (mono float32, release_tau_seconds)."""
    rng = rng or np.random.default_rng(pitch * 131 + int(vel))
    f0, freqs, amps = _piano_partial_profile(pitch, vel, sr)
    t60 = float(np.clip(14.0 * 2.0 ** (-(pitch - 21) / 22.0), 0.9, 14.0))
    length = float(np.clip(t60 * 1.0, 1.4, 7.0))
    n_samp = int(length * sr)
    t = np.arange(n_samp, dtype=np.float32) / sr
    strings = 1 if pitch < 30 else (2 if pitch < 48 else 3)
    cents = [0.0, 0.55 + 0.5 * rng.random(), -(0.55 + 0.5 * rng.random())][:strings]
    out = np.zeros(n_samp, dtype=np.float32)
    ln1000 = 6.9078
    for n, (fn, an) in enumerate(zip(freqs, amps), start=1):
        t60n = t60 / (1.0 + 0.30 * (n - 1) + 0.0004 * fn)
        tau_fast = t60n / ln1000 * 0.30
        tau_slow = t60n / ln1000 * 1.60
        env = (0.62 * np.exp(-t / tau_fast) + 0.38 * np.exp(-t / tau_slow)).astype(np.float32)
        for c in cents:
            f = fn * 2.0 ** (c / 1200.0)
            ph = 2 * np.pi * rng.random()
            out += (an / strings) * env * np.sin((2 * np.pi * f) * t + ph, dtype=np.float32)
    # Hammer: short band-limited noise + low thump, stronger when played hard
    v = float(vel) / 127.0
    k = int(0.012 * sr)
    noise = rng.standard_normal(k).astype(np.float32)
    kernel = np.ones(max(2, int(sr / max(f0 * 6.0, 400.0)))) / max(2, int(sr / max(f0 * 6.0, 400.0)))
    noise = np.convolve(noise, kernel, mode="same").astype(np.float32)
    noise *= np.exp(-np.arange(k, dtype=np.float32) / (0.0025 * sr))
    out[:k] += noise * (0.05 + 0.20 * v * v) * float(np.max(amps)) * 3.0
    # Soft attack ramp removes the click of an infinitely sharp start
    ramp = int(0.0015 * sr)
    out[:ramp] *= np.linspace(0.0, 1.0, ramp, dtype=np.float32)
    fade = int(0.08 * sr)
    out[-fade:] *= np.linspace(1.0, 0.0, fade, dtype=np.float32)
    out *= 0.9 * (v ** 1.35)
    release_tau = float(np.clip(0.34 * 2.0 ** (-(pitch - 21) / 30.0), 0.05, 0.34))
    return out, release_tau


def _pedal_intervals(instrument):
    ev = sorted((cc.time, cc.value) for cc in instrument.control_changes if cc.number == 64)
    intervals, down = [], None
    for tm, val in ev:
        if val >= 64 and down is None:
            down = tm
        elif val < 64 and down is not None:
            intervals.append((down, tm))
            down = None
    if down is not None:
        intervals.append((down, float("inf")))
    return intervals


def _stereo_reverb(x, sr=_SYNTH_SR, wet=0.17, seed=7):
    """Soundboard/room tail: decorrelated stereo noise IR, slower low band, 12 ms pre-delay."""
    try:
        from scipy.signal import fftconvolve, lfilter
    except Exception:
        return x
    rng = np.random.default_rng(seed)
    n = int(1.9 * sr)
    t = np.arange(n) / sr
    irs = []
    for _ in range(2):
        low = lfilter([0.08], [1, -0.92], rng.standard_normal(n)) * np.exp(-t / (1.7 / 6.9))
        full = rng.standard_normal(n) * np.exp(-t / (0.55 / 6.9)) * 0.25
        ir = (low * 3.2 + full)
        ir[: int(0.012 * sr)] = 0.0
        ir /= np.sqrt(np.sum(ir ** 2)) + 1e-12
        irs.append(ir.astype(np.float32))
    y = np.empty_like(x)
    for ch in (0, 1):
        y[:, ch] = x[:, ch] * (1.0 - wet) + fftconvolve(x[:, ch], irs[ch])[: len(x)] * wet * 1.6
    return y.astype(np.float32)


def render_piano_audio(midi_path, wav_path, sr=_SYNTH_SR, log=print, reverb=True):
    """Render a (piano) MIDI file to a 16-bit stereo WAV with the built-in synthesizer."""
    pm = pretty_midi.PrettyMIDI(str(midi_path))
    notes, inst_pedals = [], []
    for inst in pm.instruments:
        if inst.is_drum:
            continue
        pedals = _pedal_intervals(inst)
        for n in inst.notes:
            notes.append((float(n.start), float(n.end), int(n.pitch), int(n.velocity), pedals))
    if not notes:
        raise ValueError("렌더링할 음표가 없습니다.")
    total = max(e for _, e, _, _, _ in notes) + 9.0
    buf = np.zeros((int(total * sr) + sr, 2), dtype=np.float32)
    protos, layer_cache = {}, {}
    started = time.monotonic()
    for st, en, pitch, vel, pedals in sorted(notes):
        if not 21 <= pitch <= 108:
            continue
        layer = int(np.clip(round(vel / 10.0), 1, 12))
        key = (pitch, layer)
        if key not in protos:
            protos[key] = _piano_prototype(pitch, min(127, layer * 10))
        proto, tau = protos[key]
        off = en
        for a, b in pedals:                      # sustain pedal holds the string past key release
            if a <= en < b:
                off = min(b, en + 8.0)
                break
        i0 = int(st * sr)
        hold = max(0, int((off - st) * sr))
        tail = int(min(6.0 * tau, 1.5) * sr)
        n_use = min(len(proto), hold + tail)
        seg = proto[:n_use].copy()
        if hold < n_use:
            r = np.arange(n_use - hold, dtype=np.float32) / sr
            seg[hold:] *= np.exp(-r / tau).astype(np.float32)
        pan = np.clip((pitch - 64) / 60.0, -0.45, 0.45)       # bass left, treble right
        gl, gr = np.cos((pan + 0.5) * np.pi / 2), np.sin((pan + 0.5) * np.pi / 2)
        end = min(len(buf), i0 + n_use)
        seg = seg[: end - i0]
        buf[i0:end, 0] += seg * gl * 1.414
        buf[i0:end, 1] += seg * gr * 1.414
    log(f"피아노 합성: 음색 {len(protos)}종 생성, 음표 {len(notes)}개 믹싱 ({time.monotonic() - started:.1f}s)")
    if reverb:
        buf = _stereo_reverb(buf, sr)
    # Gentle loudness target, then soft limiter so loud chords never hard-clip
    rms = float(np.sqrt(np.mean(buf[buf.any(axis=1)] ** 2))) if buf.any() else 1.0
    buf *= 0.11 / max(rms, 1e-6)
    buf = np.tanh(buf * 1.25) / np.tanh(1.25)
    peak = float(np.max(np.abs(buf)))
    buf *= 0.92 / max(peak, 1e-6)
    last = np.where(np.abs(buf).max(axis=1) > 1e-4)[0]
    buf = buf[: (last[-1] + int(0.3 * sr)) if len(last) else len(buf)]
    sf.write(str(wav_path), buf, sr, subtype="PCM_16")
    log(f"WAV 저장: {Path(wav_path).name} ({len(buf) / sr:.1f}초)")
    return wav_path


def _correct_octave_errors(notes, y, sr, transpose=0, log=print):
    """Relabel a note one octave down when the audio has clearly more energy there and no note covers it.

    A harmonic template can lock onto the 2nd partial of a tone, producing a note an octave too
    high. Only notes whose own fundamental is >4x weaker than the octave below (and where no
    note already exists) are moved; nothing is added or removed.
    """
    if not notes:
        return notes
    n_fft, hop = 8192, 512
    fr = sr / n_fft
    S = _magnitude_stft(y, n_fft, hop, sr=sr)
    nbin, nfrm = S.shape

    def mag(p0, st, en):
        if p0 < 21 or p0 > 108:
            return 0.0
        c = 440.0 * 2.0 ** ((p0 - 69) / 12.0) / fr
        lo = max(1, int(c * 2 ** (-0.3 / 12.0)))
        hi = min(nbin - 1, max(int(np.ceil(c * 2 ** (0.3 / 12.0))), lo + 1))
        i0 = int(st * sr / hop)
        i1 = max(i0 + 1, min(int(en * sr / hop), nfrm))
        return float(np.median(S[lo:hi + 1, i0:i1].max(axis=0))) if i0 < nfrm else 0.0

    by_pitch = {}
    for n in notes:
        by_pitch.setdefault(int(n[0]), []).append(n)
    out, moved = [], 0
    for note in notes:
        p, st, en, v = int(note[0]), float(note[1]), float(note[2]), int(note[3])
        p0 = p - int(transpose)
        if 45 <= p0 <= 96 and en - st >= 0.08:
            covered = any(min(en, float(o[2])) - max(st, float(o[1])) > 0.5 * (en - st)
                          for o in by_pitch.get(p - 12, ()))
            if not covered and mag(p0 - 12, st, en) > 4.0 * max(mag(p0, st, en), 1e-9):
                out.append((p - 12, st, en, v))
                moved += 1
                continue
        out.append(note)
    if moved:
        log(f"옥타브 오류 보정: {moved}개 음표를 한 옥타브 아래로 수정")
    return out


# ---------------------------------------------------------------------------
# Rhythm grid + legato
# ---------------------------------------------------------------------------
def _fit_tempo_grid(notes, y, sr, log=print):
    """Fit a constant-tempo 16th-note grid to the note onsets. Returns (bpm, offset, coherence)."""
    try:
        oenv = librosa.onset.onset_strength(y=y, sr=sr, hop_length=256)
        tempo, _ = librosa.beat.beat_track(onset_envelope=oenv, sr=sr, hop_length=256, start_bpm=100, tightness=1000)
        prior = float(np.atleast_1d(tempo)[0])
    except Exception:
        prior = 100.0
    while prior < 70.0:
        prior *= 2.0
    while prior > 180.0:
        prior /= 2.0
    try:
        ot = librosa.frames_to_time(np.arange(len(oenv)), sr=sr, hop_length=256)
        pk = librosa.util.peak_pick(oenv, pre_max=3, post_max=3, pre_avg=5, post_avg=5, delta=0.3 * float(oenv.std()), wait=3)
        t, w = ot[pk].astype(np.float64), oenv[pk].astype(np.float64)
        if len(t) < 16:
            raise ValueError
    except Exception:
        t = np.asarray([float(n[1]) for n in notes], dtype=np.float64)
        w = np.asarray([float(n[3]) for n in notes], dtype=np.float64) ** 2
    best = (-1.0, prior, 0.0)
    for bpm in np.arange(prior * 0.94, prior * 1.06, 0.01):
        period = 60.0 / bpm / 4.0
        z = np.sum(w * np.exp(2j * np.pi * t / period))
        coh = float(abs(z) / w.sum())
        if coh > best[0]:
            best = (coh, float(bpm), float((np.angle(z) / (2 * np.pi)) * period))
    coh, bpm, off = best
    log(f"박자 분석: {bpm:.2f} BPM, 16분음표 격자 일치도 {coh:.2f}")
    return bpm, off, coh


def _quantize_and_legato(notes, y, sr, subdiv, legato, log=print):
    """Snap onsets/offsets to the beat grid and join broken notes. Returns (notes, bpm|None).

    subdiv = grid steps per beat (4 = 16th, 2 = 8th). Pitches are never changed or removed;
    only same-pitch fragments that overlap after snapping are merged.
    """
    if not notes:
        return notes, None
    bpm, off, coh = _fit_tempo_grid(notes, y, sr, log)
    if coh < 0.25:
        log("박자 정렬 생략: 뚜렷한 고정 박자를 찾지 못했습니다(자유 템포 연주로 판단).")
        return notes, None
    step = 60.0 / bpm / subdiv
    fine = 60.0 / bpm / 4.0
    snapped = []
    for p, st, en, v in notes:
        a = max(0, int(round((st - off) / step)))
        b = max(a + 1, int(round((en - off) / step)))
        snapped.append([int(p), a, b, int(v)])
    # Merge same-pitch fragments: overlapping, touching, or separated by < 1 step
    snapped.sort(key=lambda n: (n[0], n[1], n[2]))
    merged = []
    for n in snapped:
        if merged and merged[-1][0] == n[0] and n[1] <= merged[-1][2] + (1 if legato else 0):
            merged[-1][2] = max(merged[-1][2], n[2])
            merged[-1][3] = max(merged[-1][3], n[3])
        else:
            merged.append(n)
    if legato:
        # Legato per register: each note holds until the next attack in its own register
        # (bass / mid / treble), capped at 2 beats, so lines no longer stutter.
        groups = {}
        for n in merged:
            groups.setdefault(0 if n[0] < 48 else 1 if n[0] < 72 else 2, []).append(n)
        cap = max(1, int(round(2 * subdiv)))
        for g in groups.values():
            onsets = sorted({n[1] for n in g})
            for n in g:
                later = [o for o in onsets if o > n[1]]
                if not later:
                    continue
                nxt = later[0] if later[0] - n[1] <= cap else n[1] + cap
                if nxt > n[2] and nxt - n[2] <= cap:
                    n[2] = nxt
    out = [(p, a * step + off, b * step + off, v) for p, a, b, v in merged]
    out = [(p, max(0.0, s0), e0, v) for p, s0, e0, v in out if e0 > max(0.0, s0)]
    out.sort(key=lambda n: (n[1], n[0]))
    log(f"박자 정렬 완료: 격자 {step * 1000:.1f} ms, 음표 {len(notes)} -> {len(out)}개")
    return out, bpm


def convert(src, out, quality, threshold, min_dur, transpose, log, style="acoustic_ballad", high_note_denoise=True, denoise_level="clean", grid=4, legato=True, render_wav=None):
    """Decode and transcribe one bounded input; fail closed on invalid audio."""
    try:
        y, sr = sf.read(str(src), dtype="float32", always_2d=True)
    except Exception as first_exc:
        # FFmpeg fallback handles MP3/AAC/M4A codecs often missing from libsndfile.
        try:
            import subprocess
            proc = subprocess.run(["ffmpeg", "-v", "error", "-i", str(src), "-ar", "22050", "-f", "f32le", "-acodec", "pcm_f32le", "-ac", "1", "pipe:1"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=180, check=False)
            if proc.returncode != 0 or not proc.stdout:
                raise RuntimeError(proc.stderr.decode("utf-8", "replace")[-1200:])
            y = np.frombuffer(proc.stdout, dtype="<f4").copy()
            sr = 22050
        except Exception as ffmpeg_exc:
            try:
                y, sr = librosa.load(str(src), sr=None, mono=True)
            except Exception as exc:
                raise ValueError(f"오디오 디코딩 실패. libsndfile={type(first_exc).__name__}; FFmpeg={type(ffmpeg_exc).__name__}; librosa={type(exc).__name__}: {exc}") from exc
    else:
        if y.ndim != 2 or y.shape[0] == 0 or y.shape[1] == 0:
            raise ValueError("오디오 데이터가 비어 있거나 잘못되었습니다.")
        # Avoid pathological channel counts and malformed decoder output.
        if y.shape[1] > 16:
            raise ValueError("채널 수가 너무 많습니다(최대 16채널).")
        y = y.mean(axis=1, dtype=np.float32)
    if not isinstance(sr, (int, np.integer)) or sr < 1000 or sr > 384000:
        raise ValueError("지원하지 않거나 손상된 샘플레이트입니다.")
    if y.ndim != 1 or y.size == 0:
        raise ValueError("오디오를 모노 파형으로 디코딩하지 못했습니다.")
    if len(y) / float(sr) > MAX_AUDIO_SECONDS:
        raise ValueError(f"오디오가 너무 깁니다. 최대 {MAX_AUDIO_SECONDS:g}초까지 지원합니다.")
    if len(y) < sr // 2:
        raise ValueError("음원이 너무 짧습니다(최소 0.5초).")
    if not np.isfinite(y).all():
        raise ValueError("오디오에 NaN/Inf가 포함되어 있습니다.")
    peak = float(np.max(np.abs(y)))
    if peak < 1e-7:
        raise ValueError("무음 파일입니다.")
    # Preserve quiet-vs-loud note relationships while preventing clipping.
    y = (y / max(1.0, peak / 0.95)).astype(np.float32, copy=False)
    if sr != 22050:
        y = librosa.resample(y, orig_sr=sr, target_sr=22050).astype(np.float32, copy=False)
        sr = 22050
    log(f"오디오 준비 완료: {len(y)/sr:.2f}초, {sr} Hz")
    # Auto-tuning: if the recording is not at A=440 Hz, analyse a pitch-corrected copy so notes
    # are not assigned to the neighbouring semitone; note times are mapped back afterwards.
    tune_scale = 1.0
    try:
        tuning = float(librosa.estimate_tuning(y=y, sr=sr, n_fft=8192, resolution=0.01))
    except Exception:
        tuning = 0.0
    if abs(tuning) >= 0.12:
        tune_scale = 2.0 ** (tuning / 12.0)
        y_an = librosa.resample(y, orig_sr=sr, target_sr=int(round(sr * tune_scale))).astype(np.float32, copy=False)
        log(f"튜닝 보정: 원곡이 A=440Hz 대비 {tuning * 100:+.0f} cent -> 보정하여 분석")
    else:
        y_an = y
    notes = extract_notes(y_an, sr, quality, threshold, min_dur, transpose, log, high_note_denoise=high_note_denoise, denoise_level=denoise_level)
    if tune_scale != 1.0:
        notes = [(p, a / tune_scale, b / tune_scale, v) for p, a, b, v in notes]
    if not notes:
        raise ValueError("음표를 찾지 못했습니다. 감도를 조절하거나 피아노 솔로 음원으로 다시 시도하세요.")
    notes = _correct_octave_errors(notes, y, sr, transpose, log)
    tempo_bpm = None
    if grid:
        notes, tempo_bpm = _quantize_and_legato(notes, y, sr, int(grid), bool(legato), log)
    # Guard against corrupt or pathological estimator output before MIDI serialization.
    clean_notes = []
    duration = len(y) / sr
    for pitch, start, end, vel in notes:
        if not all(np.isfinite(v) for v in (start, end)):
            continue
        pitch = int(pitch); vel = int(vel)
        start = max(0.0, min(float(start), duration))
        end = max(0.0, min(float(end), duration))
        if 0 <= pitch <= 127 and 1 <= vel <= 127 and end > start:
            clean_notes.append((pitch, start, end, vel))
    if not clean_notes:
        raise ValueError("검증을 통과한 MIDI 음표가 없습니다.")
    midi = pretty_midi.PrettyMIDI(initial_tempo=float(tempo_bpm) if tempo_bpm else 120.0)
    inst = pretty_midi.Instrument(program=0, name="PianoForge DSP Estimated Piano")
    inst.notes = [pretty_midi.Note(velocity=v, pitch=p, start=a, end=b)
                  for p, a, b, v in clean_notes]
    inst.notes.sort(key=lambda n: (n.start, n.pitch, n.end))
    if style == "concert_grade":
        _apply_concert_grade_performance(inst)
    elif style == "acoustic_ballad":
        apply_acoustic_ballad_performance(inst)
    midi.instruments.append(inst)
    midi.write(str(out))
    if not out.is_file() or out.stat().st_size < 32:
        raise RuntimeError("MIDI 출력 검증에 실패했습니다.")
    log(f"MIDI 검증 완료: {len(clean_notes)}개 음표, {out.stat().st_size} bytes")
    if render_wav:
        render_piano_audio(out, render_wav, log=log)

@app.errorhandler(413)
def upload_too_large(_error):
    return jsonify(error=f"업로드 용량 제한({MAX_UPLOAD_MB} MB)을 초과했습니다."), 413

@app.errorhandler(404)
def not_found(_error):
    return jsonify(error="요청한 경로를 찾을 수 없습니다."), 404

@app.get("/health")
def health():
    """Lightweight liveness endpoint; does not load or execute the DSP bank."""
    return jsonify(status="ok", service="pianoforge-dsp", engine="adaptive-multiprofile-dsp", bank_profiles_per_pitch=160, default_style="acoustic_ballad"), 200

@app.get("/")
def index():
    return render_template_string(HTML)

@app.post("/convert")
def convert_route():
    request_id = uuid.uuid4().hex[:12]
    # Reject overload instead of allowing several long FFT jobs to OOM a notebook.
    if not _JOB_GATE.acquire(blocking=False):
        return jsonify(error="분석 작업이 이미 실행 중입니다. 완료된 뒤 다시 시도하세요.", request_id=request_id), 429
    started = time.monotonic()
    logs = []
    try:
        f = request.files.get("audio")
        if not f or not f.filename:
            return jsonify(error="오디오 파일을 선택하세요.", request_id=request_id), 400
        # Extension is a convenience filter only; decoder validation remains authoritative.
        ext = Path(f.filename).suffix.lower()
        if ext not in {".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aiff", ".aif"}:
            return jsonify(error="지원하지 않는 파일 형식입니다.", request_id=request_id), 400
        quality = request.form.get("quality", "balanced")
        if quality not in {"fast", "balanced", "detailed"}:
            return jsonify(error="quality는 fast, balanced, detailed 중 하나여야 합니다.", request_id=request_id), 400
        style = request.form.get("style", "acoustic_ballad")
        if style not in {"acoustic_ballad", "faithful", "concert_grade"}:
            return jsonify(error="style은 acoustic_ballad, faithful 또는 concert_grade이어야 합니다.", request_id=request_id), 400
        high_note_denoise = request.form.get("high_note_denoise", "true").strip().lower() not in {"0", "false", "off", "no"}
        denoise_level = request.form.get("denoise_level", "clean").strip().lower()
        if denoise_level == "off":
            high_note_denoise = False
            denoise_level = "clean"
        if denoise_level not in _DENOISE_LEVELS:
            return jsonify(error="denoise_level은 clean, max, strong, standard 또는 off여야 합니다.", request_id=request_id), 400
        grid = request.form.get("grid", "4")
        if grid not in {"0", "2", "4"}:
            return jsonify(error="grid는 0, 2, 4 중 하나여야 합니다.", request_id=request_id), 400
        legato = request.form.get("legato", "1").strip().lower() not in {"0", "false", "off", "no"}
        try:
            threshold = float(request.form.get("threshold", "0.20"))
            min_dur = float(request.form.get("min_dur", "0.07"))
            transpose_value = float(request.form.get("transpose", "0"))
            if not all(np.isfinite(v) for v in (threshold, min_dur, transpose_value)):
                raise ValueError("숫자는 유한한 값이어야 합니다.")
            if not 0.05 <= threshold <= 0.8:
                raise ValueError("threshold 범위는 0.05~0.8입니다.")
            if not 0.02 <= min_dur <= 0.5:
                raise ValueError("min_dur 범위는 0.02~0.5초입니다.")
            if not transpose_value.is_integer() or not -24 <= transpose_value <= 24:
                raise ValueError("transpose는 -24~24의 정수여야 합니다.")
            transpose = int(transpose_value)
        except (TypeError, ValueError) as exc:
            return jsonify(error=f"설정값 오류: {exc}", request_id=request_id), 400
        with tempfile.TemporaryDirectory(prefix="pianoforge_") as td:
            src = Path(td) / ("input" + ext)
            out = Path(td) / "pianoforge.mid"
            f.save(src)
            if not src.is_file() or src.stat().st_size == 0:
                return jsonify(error="업로드 파일이 비어 있습니다.", request_id=request_id), 400
            want_wav = request.form.get("render", "midi").strip().lower() == "wav"
            wav_out = Path(td) / "pianoforge.wav" if want_wav else None
            convert(src, out, quality, threshold, min_dur, transpose, logs.append, style=style, high_note_denoise=high_note_denoise, denoise_level=denoise_level, grid=int(grid), legato=legato, render_wav=wav_out)
            if want_wav:
                response = send_file(wav_out, as_attachment=True, download_name="pianoforge.wav", mimetype="audio/wav", conditional=False, max_age=0)
                response.headers["X-Request-ID"] = request_id
                response.headers["Cache-Control"] = "no-store"
                return response
            # Validate the serialized artifact before returning it to the browser.
            try:
                check = pretty_midi.PrettyMIDI(str(out))
                note_count = sum(len(i.notes) for i in check.instruments)
                if note_count == 0:
                    raise ValueError("출력 MIDI에 음표가 없습니다.")
            except Exception as exc:
                raise RuntimeError(f"MIDI 산출물 검증 실패: {exc}") from exc
            app.logger.info("request_id=%s status=success notes=%d elapsed=%.2fs",
                            request_id, note_count, time.monotonic() - started)
            response = send_file(out, as_attachment=True, download_name="pianoforge.mid",
                                 mimetype="audio/midi", conditional=False, max_age=0)
            response.headers["X-Request-ID"] = request_id
            response.headers["Cache-Control"] = "no-store"
            return response
    except Exception as e:
        detail = "\n".join(str(x) for x in logs[-20:])
        app.logger.exception("request_id=%s conversion_failed", request_id)
        message = f"{type(e).__name__}: {e}"
        if detail:
            message += "\n진행 기록:\n" + detail
        return jsonify(error=message, request_id=request_id), 500
    finally:
        _JOB_GATE.release()

# ---------------------------------------------------------------------------
# Ground-truth note-level evaluation toolkit
# ---------------------------------------------------------------------------
def _midi_note_events(midi_obj):
    events = []
    for inst in midi_obj.instruments:
        if inst.is_drum:
            continue
        for note in inst.notes:
            if 0 <= int(note.pitch) <= 127 and np.isfinite(note.start) and np.isfinite(note.end) and note.end > note.start:
                events.append((int(note.pitch), float(note.start), float(note.end), int(note.velocity)))
    return sorted(events, key=lambda n: (n[1], n[0], n[2]))


def evaluate_note_events(reference, estimate, onset_tolerance=0.05, offset_tolerance=0.15):
    """Exact-pitch, one-to-one onset matching; offset accuracy is reported separately."""
    ref = sorted(reference, key=lambda n: (n[1], n[0]))
    est = sorted(estimate, key=lambda n: (n[1], n[0]))
    candidates = []
    for ri, r in enumerate(ref):
        for ei, e in enumerate(est):
            if r[0] == e[0]:
                onset_error = abs(r[1] - e[1])
                if onset_error <= onset_tolerance:
                    candidates.append((onset_error, abs(r[2] - e[2]), ri, ei))
    candidates.sort()
    used_ref, used_est, matches = set(), set(), []
    for onset_error, offset_error, ri, ei in candidates:
        if ri not in used_ref and ei not in used_est:
            used_ref.add(ri); used_est.add(ei)
            matches.append((onset_error, offset_error))
    tp, fp, fn = len(matches), len(est) - len(matches), len(ref) - len(matches)
    precision = tp / (tp + fp) if tp + fp else (1.0 if not ref else 0.0)
    recall = tp / (tp + fn) if tp + fn else (1.0 if not est else 0.0)
    f1 = 2 * precision * recall / (precision + recall) if precision + recall else 0.0
    onset_errors = [x[0] for x in matches]
    offset_errors = [x[1] for x in matches]
    return {
        "reference_notes": len(ref), "estimated_notes": len(est),
        "true_positive": tp, "false_positive": fp, "false_negative": fn,
        "precision": round(precision, 6), "recall": round(recall, 6), "f1": round(f1, 6),
        "onset_tolerance_seconds": onset_tolerance,
        "onset_mae_seconds": round(float(np.mean(onset_errors)), 6) if onset_errors else None,
        "onset_median_error_seconds": round(float(np.median(onset_errors)), 6) if onset_errors else None,
        "offset_mae_seconds": round(float(np.mean(offset_errors)), 6) if offset_errors else None,
        "offset_within_tolerance_rate": round(sum(x <= offset_tolerance for x in offset_errors) / tp, 6) if tp else None,
        "offset_tolerance_seconds": offset_tolerance,
        "limitations": "음표 매칭은 동일 음높이와 온셋 허용오차 기준입니다. 정답 MIDI의 타이밍/페달 표기 영향을 받으며, F1 하나로 모든 음악 품질을 대표할 수 없습니다."
    }


VALIDATION_HTML = r'''<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PianoForge 정확도 검증</title><style>
body{font:16px system-ui;background:#0a0e18;color:#f2f5ff;margin:0;padding:22px}main{max-width:760px;margin:auto;background:#151d2d;padding:24px;border-radius:18px}label{display:block;margin:18px 0 7px;font-weight:700}input,select,button{width:100%;padding:12px;border-radius:9px;border:1px solid #44516a;background:#0b1220;color:#fff}button{margin-top:20px;background:#6b62ec;font-weight:800}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#080c14;padding:15px;border-radius:10px}a{color:#9ecbff}</style></head><body><main><h1>정확도 검증</h1><p>같은 곡의 오디오와 사람이 확인한 정답 MIDI를 올리세요. 전사 결과를 정답과 음표 단위로 비교합니다.</p><form id="vf" enctype="multipart/form-data"><label>원본 오디오</label><input type="file" name="audio" accept=".mp3,.wav,.flac,.ogg,.m4a,.aiff,.aif" required><label>정답 MIDI</label><input type="file" name="reference" accept=".mid,.midi" required><label>전사 품질</label><select name="quality"><option value="detailed">세밀</option><option value="balanced" selected>균형</option><option value="fast">빠름</option></select><label>온셋 허용오차</label><select name="tolerance"><option value="0.025">0.025초</option><option value="0.05" selected>0.05초</option><option value="0.10">0.10초</option></select><button>전사 후 정확도 측정</button></form><pre id="result" hidden></pre><p><a href="/">← 전사 페이지</a></p></main><script>
document.querySelector('#vf').addEventListener('submit',async e=>{e.preventDefault();const o=document.querySelector('#result');o.hidden=false;o.textContent='전사 및 비교 중입니다. 음원 길이에 따라 시간이 걸립니다.';try{const r=await fetch('/validate',{method:'POST',body:new FormData(e.target)});o.textContent=JSON.stringify(await r.json(),null,2)}catch(x){o.textContent='요청 실패: '+x}});
</script></body></html>'''


@app.get("/validate")
def validate_page():
    return render_template_string(VALIDATION_HTML)


@app.post("/validate")
def validate_route():
    request_id = uuid.uuid4().hex[:12]
    if not _JOB_GATE.acquire(blocking=False):
        return jsonify(error="분석 작업이 이미 실행 중입니다.", request_id=request_id), 429
    logs = []
    try:
        af, rf = request.files.get("audio"), request.files.get("reference")
        if not af or not af.filename or not rf or not rf.filename:
            return jsonify(error="오디오와 정답 MIDI를 모두 선택하세요."), 400
        ext = Path(af.filename).suffix.lower()
        if ext not in {".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aiff", ".aif"}:
            return jsonify(error="지원하지 않는 오디오 형식입니다."), 400
        if Path(rf.filename).suffix.lower() not in {".mid", ".midi"}:
            return jsonify(error="정답 파일은 MIDI(.mid/.midi)여야 합니다."), 400
        quality = request.form.get("quality", "balanced")
        if quality not in {"fast", "balanced", "detailed"}:
            return jsonify(error="잘못된 품질 설정입니다."), 400
        try:
            tolerance = float(request.form.get("tolerance", "0.05"))
            if not 0.01 <= tolerance <= 0.25: raise ValueError
        except ValueError:
            return jsonify(error="온셋 허용오차는 0.01~0.25초여야 합니다."), 400
        with tempfile.TemporaryDirectory(prefix="pianoforge_eval_") as td:
            td = Path(td); src = td / ("audio" + ext); ref_path = td / "reference.mid"; out = td / "estimate.mid"
            af.save(src); rf.save(ref_path)
            if not src.stat().st_size or not ref_path.stat().st_size:
                return jsonify(error="업로드한 파일이 비어 있습니다."), 400
            try: reference = _midi_note_events(pretty_midi.PrettyMIDI(str(ref_path)))
            except Exception as exc: return jsonify(error=f"정답 MIDI 읽기 실패: {type(exc).__name__}: {exc}"), 400
            if not reference: return jsonify(error="정답 MIDI에 평가할 음표가 없습니다."), 400
            convert(src, out, quality, 0.20, 0.07, 0, logs.append, style="faithful")
            estimate = _midi_note_events(pretty_midi.PrettyMIDI(str(out)))
            report = evaluate_note_events(reference, estimate, tolerance)
            report.update({"request_id": request_id, "engine": "PianoForge Acoustic Ballad Compact DSP", "quality_mode": quality, "status": "measured", "pipeline_log": logs[-12:]})
            report["metric_definitions"] = {"precision": "생성한 음표 중 정답 음표에 대응한 비율", "recall": "정답 음표 중 검출한 비율", "f1": "Precision과 Recall의 조화평균", "onset_mae_seconds": "매칭된 음표 시작 시점의 평균 절대 오차"}
            return jsonify(report), 200
    except Exception as exc:
        app.logger.exception("request_id=%s validation_failed", request_id)
        return jsonify(error=f"{type(exc).__name__}: {exc}", request_id=request_id, pipeline_log=logs[-12:]), 500
    finally:
        _JOB_GATE.release()


@app.get("/diagnostics")
def diagnostics():
    import shutil as _shutil
    return jsonify({"service":"pianoforge-dsp", "python":__import__("sys").version.split()[0], "ffmpeg_available":bool(_shutil.which("ffmpeg")), "numpy":np.__version__, "librosa":getattr(librosa,"__version__","unknown"), "soundfile":getattr(sf,"__version__","unknown"), "pretty_midi":getattr(pretty_midi,"__version__","unknown"), "evaluation_route":"/validate", "accuracy_note":"정확도는 /validate에서 동일 곡의 정답 MIDI가 있어야 측정됩니다."}), 200


# ---------------------------------------------------------------------------
# Kaggle notebook UI: upload audio -> transcribe automatically -> download MIDI
# ---------------------------------------------------------------------------
def _launch_kaggle_ui():
    """Launch an in-notebook Gradio UI; no Cloudflare tunnel or public URL needed."""
    try:
        import gradio as gr
    except ImportError as exc:
        raise RuntimeError("Gradio가 없습니다. 먼저 `!pip install -q gradio`를 실행하세요.") from exc

    def transcribe_ui(audio_path, quality, style, threshold, min_dur, transpose, high_note_denoise, denoise_level, grid, legato, render_audio, reference_path, progress=gr.Progress()):
        if not audio_path:
            return None, None, "오디오 파일을 업로드하세요. 업로드하면 자동으로 전사가 시작됩니다."
        logs = []
        try:
            source = Path(str(audio_path))
            if not source.is_file() or source.stat().st_size == 0:
                raise ValueError("업로드 파일을 읽을 수 없거나 비어 있습니다.")
            ext = source.suffix.lower()
            if ext not in {".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aiff", ".aif"}:
                raise ValueError("지원 형식: MP3, WAV, FLAC, OGG, M4A, AIFF")
            threshold = float(threshold)
            min_dur = float(min_dur)
            transpose_value = float(transpose)
            if not np.isfinite(threshold) or not 0.05 <= threshold <= 0.8:
                raise ValueError("감도 임계값은 0.05~0.8이어야 합니다.")
            if not np.isfinite(min_dur) or not 0.02 <= min_dur <= 0.5:
                raise ValueError("최소 음 길이는 0.02~0.5초여야 합니다.")
            if not transpose_value.is_integer() or not -24 <= transpose_value <= 24:
                raise ValueError("반음 이동은 -24~24 정수여야 합니다.")
            if quality not in {"fast", "balanced", "detailed"}:
                raise ValueError("분석 품질 설정이 잘못되었습니다.")
            if style not in {"acoustic_ballad", "faithful", "concert_grade"}:
                raise ValueError("연주 스타일 설정이 잘못되었습니다.")

            progress(0.05, desc="오디오 확인 중")
            out = OUTPUT / f"PianoForge_{uuid.uuid4().hex[:12]}.mid"
            progress(0.12, desc="DSP 음표 분석 중")
            convert(source, out, quality, threshold, min_dur, int(transpose_value), logs.append, style=style, high_note_denoise=bool(high_note_denoise), denoise_level=denoise_level if denoise_level in _DENOISE_LEVELS else "clean", grid=int(grid), legato=bool(legato),
                    render_wav=(out.with_suffix(".wav") if render_audio else None))
            progress(0.92, desc="MIDI 결과 확인 중")
            midi_check = pretty_midi.PrettyMIDI(str(out))
            estimated = _midi_note_events(midi_check)
            if not estimated:
                raise RuntimeError("출력 MIDI에 음표가 없습니다.")
            lines = [
                "전사 완료",
                f"입력: {source.name}",
                f"분석 모드: {quality}",
                f"스타일: {style}",
                f"고음 잡음 제거: {(denoise_level if high_note_denoise else '꺼짐')}",
                f"검출 음표: {len(estimated)}개",
                f"MIDI 크기: {out.stat().st_size:,} bytes",
            ]
            if reference_path:
                try:
                    reference = _midi_note_events(pretty_midi.PrettyMIDI(str(reference_path)))
                    if not reference:
                        lines.append("정확도 평가 생략: 정답 MIDI에 음표가 없습니다.")
                    else:
                        report = evaluate_note_events(reference, estimated, onset_tolerance=0.05)
                        lines.extend([
                            "", "정답 MIDI 기준 측정 결과 (온셋 허용오차 0.05초)",
                            f"Precision: {report['precision']:.4f}",
                            f"Recall: {report['recall']:.4f}",
                            f"F1: {report['f1']:.4f}",
                            f"온셋 MAE: {report['onset_mae_seconds']}초",
                            f"오검출: {report['false_positive']}개 / 누락: {report['false_negative']}개",
                        ])
                except Exception as exc:
                    lines.append(f"정확도 평가 실패(전사 결과는 생성됨): {type(exc).__name__}: {exc}")
            if logs:
                lines.extend(["", "처리 기록:", *logs[-8:]])
            progress(1.0, desc="완료")
            return str(out), (str(out.with_suffix(".wav")) if render_audio else None), "\n".join(lines)
        except Exception as exc:
            details = "\n".join(logs[-8:])
            message = f"실패: {type(exc).__name__}: {exc}"
            if details:
                message += "\n\n처리 기록:\n" + details
            return None, None, message

    with gr.Blocks(title="PianoForge Kaggle DSP Studio", theme=gr.themes.Soft()) as demo:
        gr.Markdown(
            "# PianoForge — Ultra-Realistic Concert-Grade DSP Studio\n"
            "MP3/WAV/FLAC/OGG/M4A/AIFF를 올리면 자동으로 피아노 연주 MIDI를 생성합니다. "
            "별도 Cloudflare 주소가 필요 없습니다. 기존 DSP 전사 엔진을 유지하며, 선택 가능한 보수적 적응형 고음 잡음 억제를 추가했습니다."
        )
        with gr.Row():
            with gr.Column(scale=1):
                audio = gr.File(label="오디오 파일 업로드 (업로드 후 자동 실행)", file_types=[".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aiff", ".aif"], type="filepath")
                quality = gr.Dropdown([("균형", "balanced"), ("세밀 (느림)", "detailed"), ("빠름", "fast")], value="balanced", label="분석 품질")
                style = gr.Dropdown([("Ultra-Realistic · Expressive · Concert-Grade", "concert_grade"), ("어쿠스틱 발라드 (기존)", "acoustic_ballad"), ("원본 타이밍 중심", "faithful")], value="concert_grade", label="연주 스타일")
                threshold = gr.Slider(0.05, 0.8, value=0.20, step=0.01, label="감도 임계값")
                min_dur = gr.Slider(0.02, 0.5, value=0.07, step=0.01, label="최소 음 길이 (초)")
                transpose = gr.Slider(-24, 24, value=0, step=1, label="반음 이동")
                high_note_denoise = gr.Checkbox(value=True, label="고음 잡음 제거 사용")
                denoise_level = gr.Dropdown([("잡음만 제거 (기본 · 실제 음은 모두 보존)", "clean"), ("최대 (고음 상한 컷)", "max"), ("강함", "strong"), ("보통", "standard")], value="clean", label="고음 잡음 제거 강도 (너무 많이 지워지면 강함/보통으로)")
                grid = gr.Dropdown([("16분음표 (기본 · 엄격)", 4), ("8분음표", 2), ("끄기", 0)], value=4, label="박자 정렬")
                legato = gr.Checkbox(value=True, label="음 이어붙이기 (끊기지 않게)")
                render_audio = gr.Checkbox(value=True, label="고음질 피아노 WAV도 생성 (내장 피아노 합성기, 곡 길이에 따라 1~3분 추가)")
                reference = gr.File(label="선택 사항: 정확도 측정용 정답 MIDI", file_types=[".mid", ".midi"], type="filepath")
                run_button = gr.Button("다시 분석 / 설정 적용", variant="primary")
            with gr.Column(scale=1):
                result_file = gr.File(label="생성된 MIDI 다운로드")
                result_audio = gr.Audio(label="피아노 WAV 미리듣기/다운로드", type="filepath")
                status = gr.Textbox(label="처리 상태 및 정확도 보고서", lines=18, interactive=False)
        inputs = [audio, quality, style, threshold, min_dur, transpose, high_note_denoise, denoise_level, grid, legato, render_audio, reference]
        # The file upload itself starts conversion; settings can be changed and rerun manually.
        audio.change(transcribe_ui, inputs=inputs, outputs=[result_file, result_audio, status], show_progress="full")
        run_button.click(transcribe_ui, inputs=inputs, outputs=[result_file, result_audio, status], show_progress="full")
        gr.Markdown(
            "**정확도 주의:** Precision/Recall/F1은 정답 MIDI를 넣었을 때만 측정됩니다. "
            "DSP 전사는 복잡한 혼합 음원에서 모든 악기·음표를 완벽히 분리한다고 보장하지 않습니다."
        )
    demo.queue(default_concurrency_limit=1, max_size=8)
    # Kaggle renders this inline. share=False avoids relying on external tunnel services.
    demo.launch(share=False, inline=True, show_error=True, prevent_thread_lock=True)


if __name__ == "__main__":
    import sys as _sys
    if len(_sys.argv) >= 4 and _sys.argv[1] == "--render":
        # python PianoForge_V7.py --render input.mid output.wav
        render_piano_audio(_sys.argv[2], _sys.argv[3])
    elif os.environ.get("PIANOFORGE_KAGGLE_UI", "1") == "1":
        _launch_kaggle_ui()
    else:
        print(f"PianoForge DSP Studio: http://127.0.0.1:7860 | upload_limit={MAX_UPLOAD_MB}MB | max_duration={MAX_AUDIO_SECONDS:g}s | concurrent_jobs={MAX_CONCURRENT_JOBS}")
        host = os.environ.get("PIANOFORGE_HOST", "0.0.0.0")
        port = int(os.environ.get("PORT", os.environ.get("PIANOFORGE_PORT", "7860")))
        app.run(host=host, port=port, debug=False, threaded=True)
